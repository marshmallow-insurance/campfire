{
  "name": "@mrshmllw/campfire",
  "version": "8.0.0",
  "description": "Collection of toasty utils and configs used by Marshmallow Technology",
  "type": "module",
  "scripts": {
    "clean": "rimraf ./dist",
    "test": "vitest run",
    "check-types": "concurrently --group \"npm run check-tsc\" \"npm run lint\" -s all --timings true",
    "check-tsc": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run clean && tsc --p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "pre-commit-lint": "npm run check-types && lint-staged",
    "commitlint": "commitlint --edit"
  },
  "exports": {
    "./configs/*": {
      "types": "./dist/configs/*.d.ts",
      "import": "./dist/configs/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "import": "./dist/telemetry/index.js"
    },
    "./telemetry/react": {
      "types": "./dist/telemetry/react.d.ts",
      "import": "./dist/telemetry/react.js"
    },
    "./telemetry/testing": {
      "types": "./dist/telemetry/testing.d.ts",
      "import": "./dist/telemetry/testing.js"
    },
    "./workflows/*": "./dist/workflows/*"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@braze/web-sdk": ">=5",
    "@commitlint/cli": ">=20",
    "@commitlint/types": ">=20",
    "@datadog/browser-logs": ">=6",
    "@datadog/browser-rum": ">=6",
    "@mrshmllw/event-registry-client": ">=1",
    "@segment/analytics-next": ">=1",
    "@semantic-release/changelog": ">=6",
    "@semantic-release/git": ">=10",
    "@sentry/react": ">=9",
    "@typescript-eslint/eslint-plugin": ">=8",
    "@typescript-eslint/parser": ">=8",
    "conventional-changelog-conventionalcommits": ">=9",
    "eslint": ">=9",
    "eslint-config-prettier": ">=9",
    "eslint-plugin-prettier": ">=4",
    "husky": ">=9",
    "lint-staged": ">=15",
    "oxlint": ">=1.79",
    "prettier": ">=3",
    "react": ">=18",
    "semantic-release": ">=25"
  },
  "peerDependenciesMeta": {
    "@braze/web-sdk": {
      "optional": true
    },
    "@commitlint/cli": {
      "optional": true
    },
    "@commitlint/types": {
      "optional": true
    },
    "@datadog/browser-logs": {
      "optional": true
    },
    "@datadog/browser-rum": {
      "optional": true
    },
    "@mrshmllw/event-registry-client": {
      "optional": true
    },
    "@segment/analytics-next": {
      "optional": true
    },
    "@semantic-release/changelog": {
      "optional": true
    },
    "@semantic-release/git": {
      "optional": true
    },
    "@sentry/react": {
      "optional": true
    },
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "conventional-changelog-conventionalcommits": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-config-prettier": {
      "optional": true
    },
    "eslint-plugin-prettier": {
      "optional": true
    },
    "husky": {
      "optional": true
    },
    "lint-staged": {
